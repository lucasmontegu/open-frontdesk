# Copy to .env. docker compose reads it automatically, and `pnpm dev` loads it into every app.

# Local infrastructure, as `docker compose up -d postgres redis livekit` exposes it on your machine.
# Containers started by docker compose ignore these and use their own internal addresses.
DATABASE_URL=postgres://ofd:ofd@localhost:5432/ofd
REDIS_URL=redis://localhost:6379
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-secret-secret-secret-secret-0
BETTER_AUTH_URL=http://localhost:3000
# The Vite dev server. It proxies /api to the API on port 3000.
PUBLIC_APP_URL=http://localhost:5173

# Required for the agent to talk. Any provider Mastra's model router supports works.
OPENAI_API_KEY=
OFD_DEFAULT_MODEL=openai/gpt-5-mini

# Voice cascade (speech-to-text and text-to-speech). Leave empty to run text channels only.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# WhatsApp through Kapso. Empty = messages are logged to the console instead of sent.
KAPSO_API_KEY=
KAPSO_BASE_URL=
KAPSO_PHONE_NUMBER_ID=

# Sign-in sessions. Change it for anything that is not your laptop: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-dev-only-change-me

# Outbound calls: your LiveKit SIP trunk id (Twilio, Telnyx or a local carrier).
LIVEKIT_SIP_TRUNK_ID=

# Inbound calls: which organization and bot version answer the phone (routing by dialed number comes later).
OFD_INBOUND_ORG_ID=
OFD_INBOUND_BOT_VERSION_ID=

# External CRM sync (optional). The built-in CRM works without these.
HUBSPOT_TOKEN=
KOMMO_TOKEN=
KOMMO_BASE_URL=

OFD_TIMEZONE=America/Argentina/Buenos_Aires

# When missions may start a call or a WhatsApp conversation, in OFD_TIMEZONE (0 = Sunday).
# Attempts outside it wait for the next opening. Confirm the legal hours for your country and use case.
OFD_CONTACT_DAYS=1,2,3,4,5,6
OFD_CONTACT_HOURS=09:00-20:00
