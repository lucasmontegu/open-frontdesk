# Copy to .env. docker compose reads it automatically.

# Required for the agent to talk. Any provider Mastra's model router supports works.
OPENAI_API_KEY=
OFD_DEFAULT_MODEL=openai/gpt-5-mini

# Voice cascade (speech-to-text and text-to-speech). Leave empty to run text channels only.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# WhatsApp through Kapso. Empty = messages are logged to the console instead of sent.
KAPSO_API_KEY=
KAPSO_BASE_URL=
KAPSO_PHONE_NUMBER_ID=

# Sign-in sessions. Change it for anything that is not your laptop: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-change-me-dev-only-change-me

# Outbound calls: your LiveKit SIP trunk id (Twilio, Telnyx or a local carrier).
LIVEKIT_SIP_TRUNK_ID=

# Inbound calls: which organization and bot version answer the phone (routing by dialed number comes later).
OFD_INBOUND_ORG_ID=
OFD_INBOUND_BOT_VERSION_ID=

# External CRM sync (optional). The built-in CRM works without these.
HUBSPOT_TOKEN=
KOMMO_TOKEN=
KOMMO_BASE_URL=

OFD_TIMEZONE=America/Argentina/Buenos_Aires
