{
  "name": "@ofd/db",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Postgres adapters (Drizzle) for the core ports, migrations and seed.",
  "exports": {
    ".": {
      "@ofd/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx --conditions=@ofd/source --env-file-if-exists=../../.env src/migrate.ts",
    "seed": "tsx --conditions=@ofd/source --env-file-if-exists=../../.env src/seed.ts",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ofd/core": "workspace:*",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
